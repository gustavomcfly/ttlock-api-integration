generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------
// 1. Núcleo e Acessos
// ------------------------------------------------------

model User {
  id            String         @id @default(uuid())
  username      String         @unique
  name          String?
  createdAt     DateTime       @default(now())

  settings      UserSettings?
  cyclicTests   CyclicTest[]
  qualityAudits QualityAudit[]
  reports       Report[]
}

model Lock {
  lockId        Int            @id
  lockAlias     String
  lockMac       String?
  createdAt     DateTime       @default(now())

  cyclicTests   CyclicTest[]
  qualityAudits QualityAudit[]
  reports       Report[]
}

// ------------------------------------------------------
// 2. Configurações (uma linha por usuário)
// ------------------------------------------------------

// Antes vivia no localStorage do navegador ("pado_test_settings").
// Agora é do usuário e acompanha o login em qualquer máquina.
model UserSettings {
  userId            String   @id
  testerName        String?
  stdPasscode       String?
  stdCard           String?
  stdFingerprint    String?
  defaultCycles     Int      @default(100)
  defaultUnlockTime Int      @default(5)
  defaultInterval   Int      @default(5)
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------
// 3. Teste de Ciclagem
// ------------------------------------------------------

model CyclicTest {
  id                     String          @id @default(uuid())
  lockId                 Int
  userId                 String?
  totalCycles            Int
  completedCycles        Float           @default(0)
  delayBetweenCycles     Int             @default(5)
  status                 String
  totalFailures          Int             @default(0)
  maxConsecutiveFailures Int             @default(3)
  lowBatteryThreshold    Int             @default(20)
  battery                Int?
  batteryStart           Int?
  batteryEnd             Int?
  startedAt              DateTime        @default(now())
  completedAt            DateTime?

  lock                   Lock            @relation(fields: [lockId], references: [lockId])
  user                   User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  logs                   CyclicTestLog[]
  report                 Report?

  @@index([userId])
  @@index([lockId])
  @@index([status])
}

model CyclicTestLog {
  id        String     @id @default(uuid())
  testId    String
  type      String
  level     String
  message   String
  timestamp DateTime   @default(now())

  test      CyclicTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId])
}

// ------------------------------------------------------
// 4. Auditoria de Qualidade
// ------------------------------------------------------

// Antes ficava só em memória do processo (Map) e sumia a cada reinício.
model QualityAudit {
  id          String             @id @default(uuid())
  lockId      Int
  userId      String?
  status      String             // "executando" | "concluido"
  testerName  String?
  params      Json?              // parâmetros usados no teste (lockName, senha/cartão/digital padrão)
  startedAt   DateTime           @default(now())
  completedAt DateTime?

  lock        Lock               @relation(fields: [lockId], references: [lockId])
  user        User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  steps       QualityAuditStep[]
  report      Report?

  @@index([userId])
  @@index([lockId])
}

model QualityAuditStep {
  id        String       @id @default(uuid())
  auditId   String
  position  Int
  stepKey   String       // "get_info", "remote_unlock", ...
  stepName  String
  status    String       // "pendente" | "executando" | "sucesso" | "falha"
  errorMsg  String?
  logs      Json         @default("[]")
  timestamp DateTime     @default(now())

  audit     QualityAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
}

// ------------------------------------------------------
// 5. Relatórios Salvos
// ------------------------------------------------------

// Snapshot (payload) do teste, mas agora ligado a quem gerou e ao teste de origem.
// Se o teste de origem for apagado, o relatório permanece (FK vira NULL).
model Report {
  id             String        @id @default(uuid())
  type           String        // "cyclic" | "quality"
  title          String
  userId         String?
  lockId         Int
  cyclicTestId   String?       @unique
  qualityAuditId String?       @unique
  lockAlias      String
  status         String
  testerName     String?
  startedAt      DateTime
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  payload        Json          // snapshot completo do teste

  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  lock           Lock          @relation(fields: [lockId], references: [lockId])
  cyclicTest     CyclicTest?   @relation(fields: [cyclicTestId], references: [id], onDelete: SetNull)
  qualityAudit   QualityAudit? @relation(fields: [qualityAuditId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([lockId])
}
