generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------
// 1. Núcleo e Acessos
// ------------------------------------------------------

model User {
  id            String         @id @default(uuid())
  username      String         @unique
  name          String?
  createdAt     DateTime       @default(now())
  
  // Relacionamentos
  cyclicTests   CyclicTest[]
  qualityAudits QualityAudit[]
}

model Lock {
  lockId        Int            @id // ID oficial vindo da API da TTLock
  lockAlias     String
  lockMac       String?
  createdAt     DateTime       @default(now())
  
  // Relacionamentos
  cyclicTests   CyclicTest[]
  qualityAudits QualityAudit[]
}

// ------------------------------------------------------
// 2. Configurações do Sistema
// ------------------------------------------------------

model Settings {
  id                 Int      @id @default(1) // Usamos sempre 1 para ter apenas uma linha de config global
  defaultDelay       Int      @default(5)
  maxFailures        Int      @default(3)
  lowBatteryAlert    Int      @default(20)
  testerName         String?
  strictValidation   Boolean  @default(false)
  updatedAt          DateTime @updatedAt
}

// ------------------------------------------------------
// 3. Teste de Ciclagem (Estresse Automático)
// ------------------------------------------------------

model CyclicTest {
  id                 String           @id @default(uuid())
  lockId             Int
  userId             String?
  totalCycles        Int
  completedCycles    Float            @default(0)
  delayBetweenCycles Int              @default(5)
  status             String           // running, paused, completed, failed, stopped
  totalFailures      Int              @default(0)
  batteryStart       Int?
  batteryEnd         Int?
  startedAt          DateTime         @default(now())
  completedAt        DateTime?

  // Chaves Estrangeiras
  lock               Lock             @relation(fields: [lockId], references: [lockId])
  user               User?            @relation(fields: [userId], references: [id])
  logs               CyclicTestLog[]
}

model CyclicTestLog {
  id        String     @id @default(uuid())
  testId    String
  type      String     // UNLOCK, LOCK, BATTERY, SYSTEM
  level     String     // info, success, warning, error
  message   String
  timestamp DateTime   @default(now())

  // Cascade: Se o teste for apagado, os logs também serão
  test      CyclicTest @relation(fields: [testId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------
// 4. Auditoria de Qualidade (QA)
// ------------------------------------------------------

model QualityAudit {
  id          String             @id @default(uuid())
  lockId      Int
  userId      String?
  status      String             // executando, aprovado, reprovado
  startedAt   DateTime           @default(now())
  completedAt DateTime?

  // Chaves Estrangeiras
  lock        Lock               @relation(fields: [lockId], references: [lockId])
  user        User?              @relation(fields: [userId], references: [id])
  steps       QualityAuditStep[]
}

model QualityAuditStep {
  id        String       @id @default(uuid())
  auditId   String
  stepName  String
  status    String       // sucesso, falha, ignorado
  details   String?
  timestamp DateTime     @default(now())

  // Cascade: Se a auditoria for apagada, as etapas também serão
  audit     QualityAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
}