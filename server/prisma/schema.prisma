generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------
// 1. Núcleo e Acessos
// ------------------------------------------------------

model User {
  id            String         @id @default(uuid())
  username      String         @unique
  name          String?
  createdAt     DateTime       @default(now())

  cyclicTests   CyclicTest[]
  qualityAudits QualityAudit[]
}

model Lock {
  lockId        Int            @id
  lockAlias     String
  lockMac       String?
  createdAt     DateTime       @default(now())

  cyclicTests   CyclicTest[]
  qualityAudits QualityAudit[]
}

// ------------------------------------------------------
// 2. Configurações do Sistema
// ------------------------------------------------------

model Settings {
  id                 Int      @id @default(1)
  defaultDelay       Int      @default(5)
  maxFailures        Int      @default(3)
  lowBatteryAlert    Int      @default(20)
  testerName         String?
  strictValidation   Boolean  @default(false)
  updatedAt          DateTime @updatedAt
}

// ------------------------------------------------------
// 3. Teste de Ciclagem
// ------------------------------------------------------

model CyclicTest {
  id                     String          @id @default(uuid())
  lockId                 Int
  userId                 String?
  totalCycles            Int
  completedCycles        Float           @default(0)
  delayBetweenCycles     Int             @default(5)
  status                 String
  totalFailures          Int             @default(0)
  maxConsecutiveFailures Int             @default(3)
  lowBatteryThreshold    Int             @default(20)
  battery                Int?
  batteryStart           Int?
  batteryEnd             Int?
  startedAt              DateTime        @default(now())
  completedAt            DateTime?

  lock                   Lock            @relation(fields: [lockId], references: [lockId])
  user                   User?           @relation(fields: [userId], references: [id])
  logs                   CyclicTestLog[]
}

model CyclicTestLog {
  id        String     @id @default(uuid())
  testId    String
  type      String
  level     String
  message   String
  timestamp DateTime   @default(now())

  test      CyclicTest @relation(fields: [testId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------
// 4. Auditoria de Qualidade
// ------------------------------------------------------

model QualityAudit {
  id          String             @id @default(uuid())
  lockId      Int
  userId      String?
  status      String
  startedAt   DateTime           @default(now())
  completedAt DateTime?

  lock        Lock               @relation(fields: [lockId], references: [lockId])
  user        User?              @relation(fields: [userId], references: [id])
  steps       QualityAuditStep[]
}

model QualityAuditStep {
  id        String       @id @default(uuid())
  auditId   String
  stepName  String
  status    String
  details   String?
  timestamp DateTime     @default(now())

  audit     QualityAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------
// 5. Relatórios Salvos
// ------------------------------------------------------

model Report {
  id          String    @id @default(uuid())
  type        String    // "cyclic" | "quality"
  title       String
  lockId      Int
  lockAlias   String
  status      String
  testerName  String?
  startedAt   DateTime
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  payload     Json      // snapshot completo do teste
}
